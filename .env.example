DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres (Supabase). Port 6543 is the PgBouncer transaction-mode pooler — see
# config/settings/base.py for the prepare_threshold caveat. Use the direct
# connection (port 5432) instead if migrations misbehave under the pooler.
DATABASE_URL=postgresql://user:password@host:6543/postgres
DB_CONN_MAX_AGE=0

# Vite picks the next free port starting at 8080 if it's taken — list a small range.
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8081,http://localhost:8082,http://localhost:8083,http://localhost:8084,http://localhost:8085

# Reconciliação: service account with Viewer access on the Google Sheet fed by the
# "novo convertido" Google Form. GOOGLE_SHEETS_CREDENTIALS_JSON is the service
# account key JSON, base64-encoded (e.g. `base64 -w0 credentials.json`).
GOOGLE_SHEETS_CREDENTIALS_JSON=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_RANGE=Respostas ao formulário 1!A:Z
