DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres (Supabase). Port 6543 is the PgBouncer transaction-mode pooler — see
# config/settings/base.py for the prepare_threshold caveat. Use the direct
# connection (port 5432) instead if migrations misbehave under the pooler.
DATABASE_URL=postgresql://user:password@host:6543/postgres
DB_CONN_MAX_AGE=0

CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8081
