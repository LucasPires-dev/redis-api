DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres (Supabase). Port 6543 is the PgBouncer transaction-mode pooler — see
# config/settings/base.py for the prepare_threshold caveat. Use the direct
# connection (port 5432) instead if migrations misbehave under the pooler.
DATABASE_URL=postgresql://user:password@host:6543/postgres
DB_CONN_MAX_AGE=0

# Vite picks the next free port starting at 8080 if it's taken — list a small range.
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8081,http://localhost:8082,http://localhost:8083,http://localhost:8084,http://localhost:8085

# Reconciliação: service account with Viewer access on the Google Sheet fed by the
# "novo convertido" Google Form. GOOGLE_SHEETS_CREDENTIALS_JSON is the service
# account key JSON, base64-encoded (e.g. `base64 -w0 credentials.json`).
GOOGLE_SHEETS_CREDENTIALS_JSON=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_RANGE=Respostas ao formulário 1!A:Z

# Redis: camada de canais do Channels (WebSocket, tempo real do módulo de
# Produção) e broker/result backend do Celery (índices de DB diferentes na
# mesma instância). Fora de Docker, aponta pro Redis local; docker-compose.yml
# e swarm-stack.yml sobrescrevem para o hostname do serviço `redis`.
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1

# Endereço público do app (links dos e-mails e dos certificados).
FRONTEND_URL=

# E-mail das notificações: qualquer provedor SMTP (Resend: smtp.resend.com,
# usuário "resend" e a API key como senha; Amazon SES: email-smtp.<região>.amazonaws.com;
# Google Workspace: smtp.gmail.com com senha de app). Sem EMAIL_HOST nenhum
# e-mail é enviado — a central de notificações funciona igual.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Redis <nao-responda@seudominio.com.br>

# ---------------------------------------------------------------------------
# Deploy de TESTE em rede local (docker-compose.yml ou swarm-stack.yml),
# acessado direto por IP:porta a partir de outro dispositivo na mesma rede,
# sem domínio e sem TLS na frente. Descomente e use estes valores nesse caso
# (troque DJANGO_SETTINGS_MODULE para config.settings.production se for via
# swarm-stack.yml, que já assume isso). NUNCA use esses valores num deploy
# exposto à internet — eles abrem mão de proteções que só fazem sentido
# quando não há TLS/proxy confiável na frente.
# ALLOWED_HOSTS=*
# CORS_ALLOW_ALL_ORIGINS=True
# SECURE_SSL_REDIRECT=False
# SESSION_COOKIE_SECURE=False
# CSRF_COOKIE_SECURE=False

# Asaas (pagamentos de inscrições). ASAAS_SANDBOX=True usa o ambiente de testes.
ASAAS_API_KEY=
ASAAS_SANDBOX=True
# Token configurado no webhook do painel do Asaas — sem ele o webhook recusa tudo.
ASAAS_WEBHOOK_TOKEN=
